DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=replace-with-your-admin-email

# Optional - powers the "AI Search" natural-language box on /vehicles.
# Get a free key at https://aistudio.google.com/apikey (no credit card required).
# If left blank, AI Search returns a 503 and the manual filters keep working normally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite